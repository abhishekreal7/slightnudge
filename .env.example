# ShipCheck Environment Variables

# App Config
NEXT_PUBLIC_APP_NAME="ShipCheck"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Worker & Server only. NEVER expose to client.

# Hyperbrowser (Cloud Browser & Agent Infrastructure)
HYPERBROWSER_API_KEY="hb_live_xxxxxxxxxxxxxxxx"
# Optional fallback to local Playwright for testing without remote cloud credits
BROWSER_PROVIDER="hyperbrowser" # "hyperbrowser" | "local"

# Anthropic LLM (Planning & Analysis)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"

# Dodo Payments (Merchant of Record)
DODO_PAYMENTS_API_KEY="dodo_api_xxxxxxxxxxxxxxxx"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_xxxxxxxxxxxxxxxx"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" | "live_mode"
DODO_PRODUCT_ID_FULL_SCAN="p_prod_xxxxxxxx"

# Security & Encryption (AES-256-GCM for test credentials at rest)
# Must be a 64-character hex string (32 bytes)
CREDENTIALS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Pricing & Cost Control (USD)
PRICE_FULL_SCAN_USD="9.99"
MIN_MARGIN_USD="3.00"
ESTIMATED_DODO_FEE_PERCENT="0.04"
ESTIMATED_DODO_FEE_FIXED_USD="0.40"
GLOBAL_DAILY_SPEND_CAP_USD="50.00"

# Run Pipeline Caps & Limits
MAX_STEPS_PER_RUN="50"
MAX_MINUTES_PER_RUN="10"
MAX_SCENARIOS_PER_RUN="12"
MAX_PAGES_DISCOVERY="25"
MAX_COST_CREDITS_PER_RUN="15.0"

# Free Preview Caps
PREVIEW_MAX_MINUTES="3"
PREVIEW_MAX_SCENARIOS="2"
